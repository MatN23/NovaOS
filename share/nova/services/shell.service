# Nova Desktop Service Definitions

[service]
name = "NovaShell"
description = "Nova Desktop Environment"
type = "notify"

[exec]
command = "/usr/libexec/nova/novashell"
args = []
environment = {}

[dependencies]
requires = ["nova-compositor"]
wants = ["nova-audiod", "nova-powerd", "nova-configd"]
before = []

[restart]
policy = "on-failure"
delay_ms = 1000
max_attempts = 3
max_attempts_interval_sec = 60

[health]
check_interval_ms = 5000
timeout_ms = 3000
type = "process"

[logging]
stdout = "journal"
stderr = "journal"
